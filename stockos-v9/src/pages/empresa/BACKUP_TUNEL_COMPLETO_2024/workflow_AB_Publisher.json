{
  "name": "{empresaId}_AB_Publisher",
  "nodes": [
    {
      "parameters": {
        "path": "={{ $json.empresaId }}/publicarAB",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.estadoConectado }}",
              "value2": "true"
            }
          ]
        }
      },
      "id": "if-conectado",
      "name": "IF Conectado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [470, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM campanas WHERE empresaId = '{{ $json.empresaId }}' AND etapa = '{{ $json.etapa }}' AND estado = 'Pendiente' LIMIT 4"
      },
      "id": "supabase-leer",
      "name": "Supabase Leer",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [690, 250]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE campanas SET estado = 'En Prueba AB - Día 1/8', fechaInicio = NOW() WHERE id IN ({{ $json.ids }})"
      },
      "id": "supabase-update",
      "name": "Supabase Update",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [910, 250]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, publicadas: 4 }) }}"
      },
      "id": "respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1130, 250]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'Conector no conectado' }) }}"
      },
      "id": "respond-error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [690, 400]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "IF Conectado", "type": "main", "index": 0 }]]
    },
    "IF Conectado": {
      "main": [
        [{ "node": "Supabase Leer", "type": "main", "index": 0 }],
        [{ "node": "Respond Error", "type": "main", "index": 0 }]
      ]
    },
    "Supabase Leer": {
      "main": [[{ "node": "Supabase Update", "type": "main", "index": 0 }]]
    },
    "Supabase Update": {
      "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["stockos", "AB", "publisher"]
}
